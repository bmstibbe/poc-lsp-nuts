{
  "type": "object",
  "required": ["resourceType", "identifier"],
  "properties": {
    "resourceType": {
      "type": "string",
      "enum": ["Organization"]
    },
    "meta": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
		  "example": "https://simplifier.net/zorg-ab/nl-core-organization-zorg-ab" 
        }
      }
    },
    "identifier": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["system", "value"],
        "properties": {
          "system": {
            "type": "string",
            "format": "uri",
			"example": "http://fhir.nl/fhir/NamingSystem/ura"
          },
          "value": {
            "type": "string",
			"example": "987654321"
          }
        }
      }
    },
    "name": {
      "type": "string",
	  "example": "Zorgaanbieder XYZ"
    },
    "active": {
      "type": "boolean",
	  "example" : true
    },
	"remoteElement": {
		"$ref": "https://raw.githubusercontent.com/bmstibbe/poc-lsp-nuts/refs/heads/main/testdir/resource.json#/myElement"
	}
  }
}