      "enum": ["Organization"]
    },
    "meta": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "identifier": {
      "type": "array",
