        "properties": {
          "system": {
            "type": "string",
            "format": "uri"
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "name": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
	  "example" : true
    },
	"remoteElement": {
		"$ref": "https://raw.githubusercontent.com/bmstibbe/poc-lsp-nuts/refs/heads/main/testdir/resource.json#/myElement"
	}
  }
}