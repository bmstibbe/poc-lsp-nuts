{
  "type": "object",
  "required": ["resourceType", "identifier"],
  "properties": {
    "resourceType": {
      "type": "string",
      "enum": ["Organization"]
    },
    {
      "$ref": "https://raw.githubusercontent.com/bmstibbe/poc-lsp-nuts/refs/heads/main/testdir/Meta.json" 
    },
    "identifier": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["system", "value"],
        "properties": {
          "system": {
            "type": "string",
            "format": "uri",
			"example": "http://fhir.nl/fhir/NamingSystem/ura"
          },
          "value": {
            "type": "string",
			"example": "987654321"
          }
        }
      }
    },
    "name": {
      "type": "string",
	  "example": "Zorgaanbieder XYZ"
    },
    "active": {
      "type": "boolean",
	  "example" : true
    }
  }
}