{
  "Organization": {
	"description": "Representation of an Organization. It will be used as the discriminating value.",
	"allOf":[
	{
	 "type": "object",
    "discriminator": {
      "propertyName": "resourceType"
    },
    "properties": {
      "resourceType": {
        "type": "string"
      },
      "id": {
        "type": "string"
      },
      "meta": {
        "$ref": "#/meta"
      }
    },
    "required": [
      "resourceType",
      "meta"
    ]
	},
    "type": "object",
    "required": [
      "identifier"
    ],
    "properties": {
      "identifier": {
        "type": "array",
        "items": {
          "type": "object",
          "$ref": "https://raw.githubusercontent.com/bmstibbe/poc-lsp-nuts/refs/heads/main/testdir/Identifier.json#/identifier"
        }
      },
      "name": {
        "type": "string",
        "example": "Zorgaanbieder XYZ"
      },
      "alias": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "active": {
        "type": "boolean",
        "example": true
      }
    }
  ]
}