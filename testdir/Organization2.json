{
  "Organization": {
	"description": "Representation of an Organization. It will be used as the discriminating value.",
	"allOf":[
	{
	"$ref": "https://raw.githubusercontent.com/bmstibbe/poc-lsp-nuts/refs/heads/main/testdir/Resource.json#/Resource"	
	},
	{
    "type": "object",
    "required": [
      "resourceType",
      "identifier"
    ],
    "properties": {
      "resourceType": {
        "type": "string",
        "enum": [
          "Organization"
        ]
      },
      "identifier": {
        "type": "array",
        "items": {
          "type": "object",
          "$ref": "https://raw.githubusercontent.com/bmstibbe/poc-lsp-nuts/refs/heads/main/testdir/Identifier.json#/identifier"
        }
      },
      "name": {
        "type": "string",
        "example": "Zorgaanbieder XYZ"
      },
      "alias": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "active": {
        "type": "boolean",
        "example": true
      }
    }
  }
  ]
}